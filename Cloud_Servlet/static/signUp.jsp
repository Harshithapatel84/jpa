<!DOCTYPE html>
<html>
<head>
    <title>Signup</title>
</head>
<body>

<h2>Signup</h2>

<form action="signup" method="post">

    User ID:
    <input type="text" name="userId">
    <br><br>

    Email:
    <input type="email" name="email">
    <br><br>

    Password:
    <input type="password" name="password">
    <br><br>

    Confirm Password:
    <input type="password" name="confirmPassword">
    <br><br>

    <input type="submit" value="Signup">

</form>

</body>
</html>